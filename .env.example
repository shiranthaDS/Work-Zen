# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ems_database

# LLM API Keys (at least one required)
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Frontend Configuration
# For local development: http://localhost:3000
# For EC2 with NGINX+SSL: https://your-domain.com
FRONTEND_URL=https://workzen.duckdns.org

# Frontend API URL
# For local development: http://localhost:8000
# For EC2 with NGINX+SSL: https://your-domain.com (frontend adds /api/ prefix)
NEXT_PUBLIC_API_URL=https://workzen.duckdns.org

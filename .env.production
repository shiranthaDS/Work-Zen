# Production Environment Variables for Work-Zen
# Copy this to .env on your EC2 instance

# MongoDB Configuration
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=ems_database

# API Keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
HUGGINGFACE_API_KEY=hf_your_key_here

# Production URLs - IMPORTANT: No /api suffix for NEXT_PUBLIC_API_URL
# The frontend code adds /api/ prefix to all endpoints
NEXT_PUBLIC_API_URL=https://workzen.duckdns.org
FRONTEND_URL=https://workzen.duckdns.org
